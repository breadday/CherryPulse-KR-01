# 실제 값은 .env 파일에만 넣고, 이 파일은 예시로만 사용합니다.
# 기본 권장값은 모의투자입니다.

RUN_MODE=paper

ACCOUNT_NO=YOUR_ACCOUNT_NO
ACCOUNT_PASSWORD=YOUR_ACCOUNT_PASSWORD
TELEGRAM_TOKEN=YOUR_TELEGRAM_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
SQLITE_DB_PATH=C:\Users\YOUR_USER\AppData\Local\CherryPulse-KR-01\cherry_pulse.sqlite3

# RUN_MODE 설명
# paper : 모의투자, 실제 주문 전송 안 함
# live  : 실주문, 실제 주문 전송
