{
    "$schema": "https://opencode.ai/config.json",

    "instructions": [
        "AGENTS.md",
        "docs/harness/DESIGN_PRINCIPLES.md",
        "docs/harness/FILE_RESPONSIBILITY.md",
        "docs/harness/CHANGE_CHECKLIST.md",
        "docs/harness/AI_WORKFLOW.md",
    ],

    "permission": {
        "read": {
            "*": "allow",
            ".env": "deny",
            ".env.*": "deny",
            ".env.example": "allow",
        },

        "edit": {
            "*": "deny",
            "core/models.py": "allow",
            "core/order_manager.py": "allow",
            "core/risk_guard.py": "allow",
            "config_live.py": "allow",
            "engine.py": "allow",
            "main_live.py": "allow",
            "infra/sqlite_store.py": "allow",
            "tests/*": "allow",
            "docs/*": "allow",
            "scripts/*": "allow",
        },

        "bash": {
            "*": "ask",
            "python -m pytest": "allow",
            "python -m pytest *": "allow",
            "python *": "allow",
            "python3 *": "allow",
            "pytest *": "allow",
            "git status *": "allow",
            "git diff *": "allow",
            "git diff --check": "allow",
            "git log *": "allow",
            "git branch --show-current": "allow",
            "git push *": "deny",
            "git commit *": "deny",
            "rm *": "deny",
        },

        "webfetch": "deny",
        "websearch": "deny",
    },
}
